                    {latestSOS.location_name || latestSOS.latitude || "—"}
                  </p>
                </div>
                <div>
                  <p className="font-extrabold text-brand text-[14px] mb-1">
                    Response Time
                  </p>
                  <p className="font-normal text-gray-800 text-[16px]">
                    {latestSOS.response_time || "—"}
