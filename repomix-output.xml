<file path="app/(dashboard)/incidents/hooks/useIncidentDetails.js">
"use client";

import { useEffect, useState } from "react";
import { getAlertResponders, getFisher } from "../lib/api";
import { describeError } from "../lib/errors";

const EMPTY = { alertId: null, fisher: null, responders: [], errors: [] };

export function useIncidentDetails(incident, refreshKey) {
  const alertId = incident?.id ?? null;
  const fisherId = incident?.fisherId ?? null;
  const [result, setResult] = useState(EMPTY);

  useEffect(() => {
    if (!alertId) return;
    let isCancelled = false;

    Promise.allSettled([getFisher(fisherId), getAlertResponders(alertId)]).then(
      ([fisherResult, respondersResult]) => {
        if (isCancelled) return;

        const errors = [];
        if (fisherResult.status === "rejected") {
          errors.push(describeError("fisher details", fisherResult.reason));
        }
        if (respondersResult.status === "rejected") {
          errors.push(describeError("responders", respondersResult.reason));
        }

        setResult({
          alertId,
          fisher:
            fisherResult.status === "fulfilled" ? fisherResult.value : null,
          responders:
            respondersResult.status === "fulfilled"
              ? respondersResult.value
              : [],
          errors: [...new Set(errors)],
        });
      },
    );

    return () => {
      isCancelled = true;
    };
  }, [alertId, fisherId, refreshKey]);

  const isCurrent = result.alertId === alertId;
  return {
    fisher: isCurrent ? result.fisher : null,
    responders: isCurrent ? result.responders : [],
    errors: isCurrent ? result.errors : [],
    isLoading: Boolean(alertId) && !isCurrent,
  };
}
</file>

<file path="app/(dashboard)/incidents/hooks/useIncidents.js">
"use client";

import { useEffect, useState } from "react";
import { api } from "@/lib/api"; // The main frontend API
import { POLL_INTERVAL_MS } from "../lib/constants";

export function useIncidents() {
  const [incidents, setIncidents] = useState([]);
  const [error, setError] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [updatedAt, setUpdatedAt] = useState(null);

  useEffect(() => {
    let isCancelled = false;

    async function load() {
      try {
        const alerts = await api.getAllAlerts();

        if (isCancelled) return;

        const formatted = alerts.map((alert) => {
          // The backend sends 'triggered', 'acknowledged', or 'resolved'
          return {
            id: alert.alert_id,
            displayId: alert.alert_id.slice(0, 8).toUpperCase(),
            latitude: alert.latitude,
            longitude: alert.longitude,
            status: alert.status, 
            triggeredAt: alert.triggered_at,
            fisherId: alert.fisher_id, 
            fisherCount: alert.number_of_fishers || 1, 
          };
        });

        setIncidents(formatted);
        setError(null);
        setUpdatedAt(Date.now());
      } catch (caught) {
        if (isCancelled) return;
        setError("Failed to load live incidents.");
      } finally {
        if (!isCancelled) setIsLoading(false);
      }
    }

    load();
    const timer = setInterval(load, POLL_INTERVAL_MS || 10000); 
    
    return () => {
      isCancelled = true;
      clearInterval(timer);
    };
  }, []);

  return { incidents, error, isLoading, updatedAt };
}
</file>

<file path="app/(dashboard)/incidents/lib/api.js">
import { api } from "@/lib/api";
import { toIncident } from "./incidents";

export async function getActiveIncidents() {
  const [triggered, acknowledged, locations] = await Promise.all([
    api.getAlerts("triggered"),
    api.getAlerts("acknowledged"),
    api.getLocations(),
  ]);

  const locationMap = locations.reduce((acc, loc) => {
    acc[loc.location_id] = loc;
    return acc;
  }, {});

  return [...triggered, ...acknowledged]
    .map((alert, index) => {
      const loc = locationMap[alert.location_id];
      return toIncident({ ...alert, location: loc }, index);
    })
    .sort((a, b) => new Date(b.triggeredAt) - new Date(a.triggeredAt));
}

export function getFisher(fisherId) {
  return api.getFisher(fisherId);
}

export function getAlertResponders(alertId) {
  return api.getAlertResponders(alertId);
}
