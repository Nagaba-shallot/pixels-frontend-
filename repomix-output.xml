                View More
              </Button>
            </div>
          </div>
        </>
      )}

      {activeView === "trips" && (
        <div className="flex-1 min-h-0 max-h-[60vh] overflow-y-auto border-2 border-[#00d2ff] rounded-xl px-4 pb-4">
