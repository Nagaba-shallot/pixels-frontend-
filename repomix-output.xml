<file path="app/(dashboard)/settings/page.jsx">
"use client";
import { useState, useEffect } from "react";
import { useForm } from "react-hook-form";
import PageHeader from "@/components/PageHeader";
import { Button, Field, Panel, Modal } from "@/components/ui";
import { api } from "@/lib/api";

function Spinner({ className = "h-4 w-4" }) {
  return (
    <svg
      className={`animate-spin ${className}`}
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <circle
        className="opacity-25"
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        strokeWidth="4"
      />
      <path
        className="opacity-75"
        fill="currentColor"
        d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
      />
    </svg>
  );
}

export default function SettingsPage() {
  const [currentUser, setCurrentUser] = useState(null);
  const [loadError, setLoadError] = useState("");
  const [retryKey, setRetryKey] = useState(0);

  const [operators, setOperators] = useState([]);
  const [showOperatorModal, setShowOperatorModal] = useState(false);
  const [opError, setOpError] = useState("");
  const [opLoading, setOpLoading] = useState(false);

  const [operatorToDelete, setOperatorToDelete] = useState(null);
  const [deleteError, setDeleteError] = useState("");
  const [isDeleting, setIsDeleting] = useState(false);
  const [deleteBlocked, setDeleteBlocked] = useState(false);

  const [resetStep, setResetStep] = useState(1);
  const [resetEmail, setResetEmail] = useState("");
  const [resetToken, setResetToken] = useState("");
  const [otpCode, setOtpCode] = useState("");
  const [newPassword, setNewPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [resetLoading, setResetLoading] = useState(false);
  const [resetStatus, setResetStatus] = useState({ type: "", message: "" });

  const [fishers, setFishers] = useState([]);
  const [loadingFishers, setLoadingFishers] = useState(true);
  const [selectedFisherId, setSelectedFisherId] = useState("");
  const [fisherLoading, setFisherLoading] = useState(false);
  const [fisherStatus, setFisherStatus] = useState({ type: "", message: "" });
  const [pendingOtp, setPendingOtp] = useState(null);
  const [otpInput, setOtpInput] = useState("");

  const {
    register,
    handleSubmit,
    formState: { errors },
    reset,
  } = useForm();

  const {
    register: registerOp,
    handleSubmit: handleSubmitOp,
    formState: { errors: opErrors },
    reset: resetOp,
  } = useForm();

  const retry = () => {
    setLoadError("");
    setRetryKey((k) => k + 1);
  };

  useEffect(() => {
    let cancelled = false;
    async function init() {
      try {
        const me = await api.getCurrentOperator();
        if (cancelled) return;
        setCurrentUser(me);
        if (me.role === "super_admin") {
          const ops = await api.getAllOperators();
          if (cancelled) return;
          setOperators(ops);
        }
      } catch (e) {
        if (cancelled) return;
        if (e?.status === 403) {
          setLoadError("You do not have access to operator management.");
        } else if (e?.status !== 401) {
          setLoadError(e?.message || "Failed to load account settings.");
        }
      }
    }
    init();
    return () => {
      cancelled = true;
    };
  }, [retryKey]);

  useEffect(() => {
    let cancelled = false;
    setLoadingFishers(true);
    async function loadFishers() {
      try {
        const data = await api.getFishers("?limit=10000");
        if (cancelled) return;
        setFishers(data);
      } catch (err) {
        if (cancelled) return;
        if (err?.status !== 401) {
          setLoadError(
            (prev) => prev || err?.message || "Failed to load fishers.",
          );
        }
      } finally {
        if (!cancelled) setLoadingFishers(false);
      }
    }
    loadFishers();
    return () => {
      cancelled = true;
    };
  }, [retryKey]);

  async function handleCreateOperator(data) {
    setOpError("");
    setOpLoading(true);
    try {
      await api.createOperator(data);

      try {
        const ops = await api.getAllOperators();
        setOperators(ops);
      } catch (fetchErr) {
        console.warn("Operator created, but list refresh failed:", fetchErr);
      }

      setShowOperatorModal(false);
      resetOp();
    } catch (err) {
      setOpError(err.message || "Failed to create operator.");
    } finally {
      setOpLoading(false);
    }
  }

  async function confirmDeleteOperator() {
    if (!operatorToDelete || deleteBlocked || isDeleting) return;

    setDeleteError("");
    setIsDeleting(true);

    try {
      await Promise.all([
        api.deleteOperator(operatorToDelete.operator_id),
        new Promise((resolve) => setTimeout(resolve, 600)),
      ]);

      setOperators((prev) =>
        prev.filter((o) => o.operator_id !== operatorToDelete.operator_id),
      );
      setOperatorToDelete(null);
    } catch (err) {
      setDeleteError(err?.message || "Failed to delete operator.");

      if (err?.status === 400 || err?.status === 409) {
        setDeleteBlocked(true);
      }
    } finally {
      setIsDeleting(false);
    }
  }

  async function handlePasswordReset(e) {
    e.preventDefault();
    setResetStatus({ type: "", message: "" });
    setResetLoading(true);
    try {
      if (resetStep === 1) {
        if (!resetEmail) throw new Error("Please enter your email.");
        await api.requestPasswordResetCode(resetEmail);
        setResetStatus({ type: "success", message: "Verification code sent." });
        setResetStep(2);
      } else if (resetStep === 2) {
        const data = await api.verifyPasswordResetCode(resetEmail, otpCode);
        setResetToken(data.reset_token);
        setResetStatus({
          type: "success",
          message: "Code verified. Enter new password.",
        });
        setResetStep(3);
      } else if (resetStep === 3) {
        if (newPassword !== confirmPassword)
          throw new Error("Passwords do not match.");
        await api.confirmPasswordReset(resetToken, newPassword);
        setResetStatus({ type: "success", message: "Password updated!" });

        setResetStep(1);
        setOtpCode("");
        setNewPassword("");
        setConfirmPassword("");
        setResetToken("");
        setResetEmail("");
      }
    } catch (err) {
      setResetStatus({ type: "error", message: err.message });
    } finally {
      setResetLoading(false);
    }
  }

  const saveFisherPhone = async (data) => {
    setFisherStatus({ type: "", message: "" });
    if (!selectedFisherId) {
      setFisherStatus({ type: "error", message: "Please select a fisher." });
      return;
    }
    setFisherLoading(true);
    try {
      const res = await api.updateFisherPhone(
        selectedFisherId,
        data.phone_number,
      );

      if (res.pending_phone_number) {
        setPendingOtp({
          fisherId: selectedFisherId,
          phone: res.pending_phone_number,
        });
        setFisherStatus({
          type: "success",
          message: "OTP sent to the new number.",
        });
      } else {
        setFisherStatus({
          type: "success",
          message: "Phone number is already up to date.",
        });
      }
    } catch (err) {
      setFisherStatus({ type: "error", message: err.message });
    } finally {
      setFisherLoading(false);
    }
  };

  const confirmOtp = async (otp) => {
    setFisherStatus({ type: "", message: "" });
    setFisherLoading(true);
    try {
      await api.confirmFisherPhone(pendingOtp.fisherId, otp);
      setFisherStatus({
        type: "success",
        message: `Phone number successfully updated!`,
      });
      setPendingOtp(null);
      setOtpInput("");
      setSelectedFisherId("");
      reset();
    } catch (err) {
      setFisherStatus({ type: "error", message: err.message });
    } finally {
      setFisherLoading(false);
    }
  };

  return (
    <>
      <PageHeader title="System Settings" subtitle="Manage your account" />

      {loadError && (
        <div
          className="mb-4 flex items-center justify-between rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700"
          role="alert"
        >
          <span>{loadError}</span>
          <button
            type="button"
            onClick={retry}
            className="ml-4 rounded bg-red-600 px-3 py-1 text-xs font-semibold text-white hover:bg-red-700"
          >
            Retry
          </button>
        </div>
      )}

      <div className="grid w-full min-w-0 gap-8 lg:grid-cols-2">
        {currentUser?.role === "super_admin" && (
          <Panel title="Operator Management" className="lg:col-span-2">
            <div className="mb-4 flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center">
              <p className="text-sm text-gray-500">
                Manage operators who can access the dashboard.
              </p>
              <Button
                onClick={() => setShowOperatorModal(true)}
                className="w-full sm:w-auto"
              >
                + Add Operator
              </Button>
            </div>

            <div className="w-full overflow-auto max-h-80 border border-gray-100 rounded-md">
              <table className="w-full min-w-[700px] text-left border-collapse">
                <thead className="sticky top-0 z-10 bg-white shadow-[0_1px_0_0_#e5e7eb]">
                  <tr>
                    <th className="py-3 px-4 font-semibold text-gray-700 whitespace-nowrap">
                      Name
                    </th>
                    <th className="py-3 px-4 font-semibold text-gray-700 whitespace-nowrap">
                      Email
                    </th>
                    <th className="py-3 px-4 font-semibold text-gray-700 whitespace-nowrap">
                      Role
                    </th>
                    <th className="py-3 px-4 font-semibold text-gray-700 text-right whitespace-nowrap">
                      Action
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {operators.map((op) => (
                    <tr
                      key={op.operator_id}
                      className="border-b border-gray-100"
                    >
                      <td className="py-3 px-4 whitespace-nowrap">
                        {op.first_name} {op.last_name}
                      </td>
                      <td className="py-3 px-4 whitespace-nowrap">
                        {op.email}
                      </td>
                      <td className="py-3 px-4 text-sm uppercase text-gray-600 whitespace-nowrap">
                        {op.role}
                      </td>
                      <td className="py-3 px-4 text-right whitespace-nowrap">
                        <button
                          onClick={() => {
                            setOperatorToDelete(op);
                            setDeleteError("");
                            setDeleteBlocked(false);
                          }}
                          className="text-red-500 hover:underline text-sm disabled:opacity-50"
                          disabled={isDeleting}
                        >
                          Delete
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </Panel>
        )}

        <Panel title="Landing Site Operator Account Settings">
          <form onSubmit={handlePasswordReset} className="space-y-5">
            {resetStep === 1 && (
              <Field
                label="Operator Email"
                type="email"
                value={resetEmail}
                onChange={(e) => setResetEmail(e.target.value)}
                disabled={resetLoading}
                required
              />
            )}
            {resetStep === 2 && (
              <Field
                label="Enter OTP Code"
                value={otpCode}
                onChange={(e) => setOtpCode(e.target.value)}
                disabled={resetLoading}
                required
              />
            )}
            {resetStep === 3 && (
              <>
                <Field
                  label="Enter New Password"
                  type="password"
                  value={newPassword}
                  onChange={(e) => setNewPassword(e.target.value)}
                  disabled={resetLoading}
                  required
                />
                <Field
                  label="Confirm New Password"
                  type="password"
                  value={confirmPassword}
                  onChange={(e) => setConfirmPassword(e.target.value)}
                  disabled={resetLoading}
                  required
                />
              </>
            )}
            {resetStatus.message && (
              <p
                className={`text-sm font-semibold ${resetStatus.type === "error" ? "text-red-600" : "text-green-600"}`}
              >
                {resetStatus.message}
              </p>
            )}
            <Button
              type="submit"
              className="!py-2 text-xs"
              disabled={resetLoading}
            >
              {resetLoading
                ? "Processing..."
                : resetStep === 1
                  ? "Send Reset Code"
                  : resetStep === 2
                    ? "Verify Code"
                    : "Save Changes"}
            </Button>
          </form>
        </Panel>

        <Panel title="Fisher Account Settings">
          <form onSubmit={handleSubmit(saveFisherPhone)} className="space-y-5">
            <div>
              <label className="block text-sm font-medium text-[#12808f] mb-1">
                Select Fisher
              </label>
              <select
                value={selectedFisherId}
                onChange={(e) => setSelectedFisherId(e.target.value)}
                className="w-full px-3 py-2 border border-slate-200 rounded-lg text-slate-800 bg-white focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 disabled:opacity-50"
                disabled={loadingFishers || fisherLoading}
              >
                <option value="">
                  {loadingFishers
                    ? "Loading fishers..."
                    : "-- Choose a fisher --"}
                </option>
                {fishers.map((f) => (
                  <option key={f.fisher_id} value={f.fisher_id}>
                    {f.full_name} ({f.phone_number})
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label className="block text-sm font-medium text-[#12808f] mb-1">
                Enter new phone number
              </label>
              <input
                type="tel"
                {...register("phone_number", {
                  required: "Phone number is required",
                  pattern: {
                    value: /^\+[1-9]\d{1,14}$/,
                    message: "Please include the country code (e.g., +254...)",
                  },
                })}
                disabled={fisherLoading}
                className="w-full px-3 py-2 border border-slate-200 rounded-lg text-slate-800 bg-white focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 disabled:opacity-50"
                placeholder="+254 712 345 678"
              />
              {errors.phone_number && (
                <p className="text-red-500 text-xs mt-1">
                  {errors.phone_number.message}
                </p>
              )}
            </div>

            {fisherStatus.message && (
              <p
                className={`text-sm font-semibold ${fisherStatus.type === "error" ? "text-red-600" : "text-green-600"}`}
              >
                {fisherStatus.message}
              </p>
            )}

            <Button
              type="submit"
              className="!py-2 text-xs"
              disabled={fisherLoading}
            >
              {fisherLoading ? "Saving..." : "Save Changes"}
            </Button>
          </form>
        </Panel>
      </div>

      <Modal
        open={showOperatorModal}
        onClose={() => {
          setShowOperatorModal(false);
          resetOp();
        }}
        label="Create Operator"
      >
        <form
          onSubmit={handleSubmitOp(handleCreateOperator)}
          className="space-y-4"
        >
          <h2 className="text-lg font-bold mb-4">Create New Operator</h2>

          <Field
            label="First Name"
            {...registerOp("first_name", {
              required: "First name is required",
            })}
            error={opErrors.first_name?.message}
          />

          <Field
            label="Last Name"
            {...registerOp("last_name", { required: "Last name is required" })}
            error={opErrors.last_name?.message}
          />

          <Field
            label="Email"
            type="email"
            {...registerOp("email", {
              required: "Email is required",
              pattern: {
                value: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
                message: "Invalid email format",
              },
            })}
            error={opErrors.email?.message}
          />

          <Field
            label="Password"
            type="password"
            {...registerOp("password", {
              required: "Password is required",
              minLength: {
                value: 8,
                message: "Password must be at least 8 characters",
              },
            })}
            error={opErrors.password?.message}
          />

          {opError && <p className="text-red-500 text-sm">{opError}</p>}
          <Button type="submit" className="w-full" disabled={opLoading}>
            {opLoading ? "Creating..." : "Create Operator"}
          </Button>
        </form>
      </Modal>

      <Modal
        open={!!operatorToDelete}
        onClose={() => {
          if (isDeleting) return;
          setOperatorToDelete(null);
          setDeleteError("");
        }}
        label="Confirm Delete"
      >
        <div className="space-y-4">
          <h2 className="text-lg font-bold text-red-600">Delete Operator?</h2>
          <p className="text-sm text-gray-600">
            Are you sure you want to permanently delete{" "}
            <strong>
              {operatorToDelete?.first_name} {operatorToDelete?.last_name}
            </strong>
            ? This action cannot be undone.
          </p>

          {deleteError && (
            <div className="rounded-md bg-red-50 p-3 text-sm text-red-700">
              {deleteError}
            </div>
          )}

          <div className="flex gap-4 pt-2">
            <Button
              onClick={() => {
                setOperatorToDelete(null);
                setDeleteError("");
              }}
              disabled={isDeleting}
              className="flex-1 !bg-gray-200 !text-gray-800 hover:!bg-gray-300 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {deleteBlocked ? "Close" : "Cancel"}
            </Button>
            <Button
              onClick={confirmDeleteOperator}
              disabled={isDeleting || deleteBlocked}
              aria-busy={isDeleting}
              className="flex-1 flex items-center justify-center gap-2 bg-red-600 text-white hover:bg-red-700 disabled:opacity-60 disabled:cursor-not-allowed"
            >
              {isDeleting && <Spinner />}
              {isDeleting
                ? "Deleting..."
                : deleteBlocked
                  ? "Cannot Delete"
                  : "Yes, Delete"}
            </Button>
          </div>
        </div>
      </Modal>

      <Modal
        open={!!pendingOtp}
        onClose={() => {
          if (fisherLoading) return;
          setPendingOtp(null);
          setOtpInput("");
        }}
        label="Confirm OTP"
      >
        <form
          onSubmit={(e) => {
            e.preventDefault();
            confirmOtp(otpInput);
          }}
          className="space-y-4"
        >
          <h2 className="text-lg font-bold mb-2">Verify Phone Change</h2>
          <p className="text-sm text-gray-600 mb-4">
            Enter the OTP sent to {pendingOtp?.phone}.
          </p>

          <div>
            <label className="block text-sm font-medium text-[#12808f] mb-1">
              OTP Code
            </label>
            <input
              type="text"
              value={otpInput}
              onChange={(e) => setOtpInput(e.target.value)}
              disabled={fisherLoading}
              className="w-full px-3 py-2 border border-slate-200 rounded-lg text-slate-800 bg-white focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 disabled:opacity-50"
              placeholder="Enter 6-digit code"
              required
              maxLength={6}
            />
          </div>

          {fisherStatus.message && (
            <p
              className={`text-sm font-semibold ${fisherStatus.type === "error" ? "text-red-600" : "text-green-600"}`}
            >
              {fisherStatus.message}
            </p>
          )}
          <Button type="submit" className="w-full" disabled={fisherLoading}>
            {fisherLoading ? "Verifying..." : "Confirm OTP"}
          </Button>
        </form>
      </Modal>
    </>
  );
}
</file>

<file path="app/(dashboard)/wristbands/page.jsx">
"use client";

import { Suspense, useEffect, useMemo, useRef, useState } from "react";
import Image from "next/image";
import PageHeader from "@/components/PageHeader";
import { Panel } from "@/components/ui";
import DataTable from "@/components/ui/DataTable";
import useFocusTrap from "@/components/ui/useFocusTrap";
import { api } from "@/lib/api";

const STATUS_TONE = {
  Available: "bg-green-200/70 text-green-800",
  Unavailable: "bg-red-300 text-red-600",
};

function ToggleButton({ active, onClick, icon, children }) {
  return (
    <button
      type="button"
      aria-pressed={active}
      onClick={onClick}
      className={`flex items-center gap-2 rounded-full px-5 py-2 text-xs transition-colors ${
        active
          ? "bg-brand text-white font-medium"
          : "text-brand hover:bg-brand/10"
      }`}
    >
      <Image
        src={`/${icon}-${active ? "white" : "teal"}.svg`}
        alt=""
        width={16}
        height={16}
      />
      {children}
    </button>
  );
}

function AssignModal({
  wristband,
  fishers,
  fishersError,
  assignmentError,
  isAssigning,
  returnFocusRef,
  onClose,
  onAssign,
}) {
  const [fisherId, setFisherId] = useState("");
  const dialogRef = useRef(null);
  const fisherSelectRef = useRef(null);

  useFocusTrap(dialogRef, {
    onClose,
    initialFocusRef: fisherSelectRef,
    returnFocusRef,
  });

  return (
    <div
      className="fixed inset-0 z-2000 flex items-center justify-center bg-black/40 p-4"
      onClick={onClose}
    >
      <div
        ref={dialogRef}
        role="dialog"
        aria-modal="true"
        aria-labelledby="assign-title"
        className="w-full max-w-lg rounded-xl bg-white px-8 py-7 shadow-xl"
        onClick={(e) => e.stopPropagation()}
      >
        <div className="flex items-center justify-between">
          <h2 id="assign-title" className="text-xl font-bold text-brand">
            Assign Wristbands
          </h2>

          <button
            type="button"
            onClick={onClose}
            aria-label="Close"
            className="text-brand"
          >
            <Image src="/close.svg" alt="" width={20} height={20} />
          </button>
        </div>

        <label htmlFor="select-fisher" className="mt-8 mb-3 block text-lg">
          Select Fisher
        </label>

        <div className="relative">
          <select
            ref={fisherSelectRef}
            id="select-fisher"
            value={fisherId}
            onChange={(e) => setFisherId(e.target.value)}
            disabled={isAssigning}
            className={`h-14 w-full appearance-none rounded-lg border border-aqua/40 bg-mist px-4 pr-12 text-sm outline-none focus:border-brand ${
              fisherId ? "text-gray-900" : "text-brand/60"
            }`}
          >
            <option value="">Choose Fisher</option>

            {fishers.map((fisher) => (
              <option key={fisher.fisher_id} value={fisher.fisher_id}>
                {fisher.full_name}
              </option>
            ))}
          </select>

          <Image
            src="/chevron-down-black.svg"
            alt=""
            width={20}
            height={20}
            className="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2"
          />
        </div>

        {fishersError && (
          <p role="alert" className="mt-2 text-sm text-red-600">
            {fishersError}
          </p>
        )}

        <label htmlFor="wristband-id" className="mt-8 mb-3 block text-lg">
          Wristband
        </label>

        <input
          id="wristband-id"
          readOnly
          value={wristband.rfid_tag ?? wristband.id}
          className="h-14 w-full rounded-lg border border-aqua/40 bg-mist px-4 text-sm font-medium text-brand outline-none"
        />

        {assignmentError && (
          <p role="alert" className="mt-3 text-sm text-red-600">
            {assignmentError}
          </p>
        )}

        <div className="mt-10 flex gap-4">
          <button
            type="button"
            onClick={onClose}
            className="h-12 flex-1 rounded-lg border border-brand bg-white text-sm font-semibold text-brand hover:bg-mist"
          >
            Cancel
          </button>

          <button
            type="button"
            disabled={!fisherId || isAssigning}
            onClick={() => onAssign(fisherId)}
            className="h-12 flex-1 rounded-lg bg-brand text-sm font-semibold text-white hover:bg-brand-active disabled:cursor-not-allowed disabled:opacity-60"
          >
            {isAssigning ? "Assigning..." : "Assign"}
          </button>
        </div>
      </div>
    </div>
  );
}

export default function WristbandsPage() {
  const [tab, setTab] = useState("all");
  const [query, setQuery] = useState("");
  const [registered, setRegistered] = useState([]);
  const [fishers, setFishers] = useState([]);
  const [assigning, setAssigning] = useState(null);
  const [isAssigning, setIsAssigning] = useState(false);
  const [isLoading, setIsLoading] = useState(true);
  const [loadError, setLoadError] = useState("");
  const [fishersError, setFishersError] = useState("");
  const [assignmentError, setAssignmentError] = useState("");

  const returnFocusRef = useRef(null);
  const assignInFlightRef = useRef(false);

  useEffect(() => {
    let alive = true;

    const loadData = async () => {
      const [wristbandsResult, fishersResult] = await Promise.allSettled([
        api.getAllWristbands(),
        api.getAllFishers(),
      ]);

      if (!alive) return;

      if (
        wristbandsResult.status === "fulfilled" &&
        Array.isArray(wristbandsResult.value)
      ) {
        setRegistered(wristbandsResult.value);
        setLoadError("");
      } else {
        setLoadError(
          wristbandsResult.status === "rejected"
            ? (wristbandsResult.reason?.message ?? "Unable to load wristbands.")
            : "The wristband response was not a list.",
        );
      }

      if (
        fishersResult.status === "fulfilled" &&
        Array.isArray(fishersResult.value)
      ) {
        setFishers(fishersResult.value);
        setFishersError("");
      } else {
        setFishersError(
          fishersResult.status === "rejected"
            ? (fishersResult.reason?.message ?? "Unable to load fishers.")
            : "The fisher response was not a list.",
        );
      }

      setIsLoading(false);
    };

    loadData();

    return () => {
      alive = false;
    };
  }, []);

  const fisherNamesById = useMemo(
    () =>
      new Map(fishers.map((fisher) => [fisher.fisher_id, fisher.full_name])),
    [fishers],
  );

  const wristbandRows = useMemo(
    () =>
      registered.map((wristband) => {
        const isAssigned = Boolean(wristband.fisher_id);

        return {
          ...wristband,
          id: wristband.rfid_tag ?? wristband.wristband_id,
          fisher: isAssigned
            ? (fisherNamesById.get(wristband.fisher_id) ?? "")
            : "",
          status: isAssigned ? "Unavailable" : "Available",
          checkIn: "—",
          checkOut: "—",
        };
      }),
    [registered, fisherNamesById],
  );

  const q = query.trim().toLowerCase();

  const assignedRows = wristbandRows.filter(
    (wristband) => wristband.status === "Unavailable",
  );

  const allRows = useMemo(
    () =>
      wristbandRows.filter(
        (w) =>
          !q ||
          w.fisher.toLowerCase().includes(q) ||
          w.id.toLowerCase().includes(q),
      ),
    [wristbandRows, q],
  );

  const checkedOutRows = useMemo(
    () =>
      wristbandRows.filter(
        (w) =>
          w.status === "Unavailable" &&
          (!q || w.fisher.toLowerCase().includes(q)),
      ),
    [wristbandRows, q],
  );

  const assign = async (fisherId) => {
    if (!assigning || assignInFlightRef.current) return;

    assignInFlightRef.current = true;
    setIsAssigning(true);
    setAssignmentError("");

    try {
      const updatedWristband = await api.assignWristband(
        assigning.wristband_id,
        fisherId,
      );

      if (!updatedWristband?.wristband_id) {
        throw new Error("The wristband API returned an invalid response.");
      }

      setRegistered((rows) =>
        rows.map((wristband) =>
          wristband.wristband_id === updatedWristband.wristband_id
            ? updatedWristband
            : wristband,
        ),
      );

      setAssigning(null);
    } catch (error) {
      setAssignmentError(
        error instanceof Error ? error.message : "Unable to assign wristband.",
      );
    } finally {
      assignInFlightRef.current = false;
      setIsAssigning(false);
    }
  };

  const unassign = async (wristband) => {
    if (assignInFlightRef.current) return;

    assignInFlightRef.current = true;
    setAssignmentError("");

    try {
      const updatedWristband = await api.unassignWristband(
        wristband.wristband_id,
      );

      if (!updatedWristband?.wristband_id) {
        throw new Error("The wristband API returned an invalid response.");
      }

      setRegistered((rows) =>
        rows.map((w) =>
          w.wristband_id === updatedWristband.wristband_id
            ? updatedWristband
            : w,
        ),
      );
    } catch (error) {
      setLoadError(
        error instanceof Error
          ? error.message
          : "Unable to unassign wristband.",
      );
    } finally {
      assignInFlightRef.current = false;
    }
  };

  const allColumns = [
    {
      accessorKey: "id",
      header: "Wristband ID",
    },
    {
      accessorKey: "status",
      header: "Status",
      meta: { center: true },
      cell: ({ row }) => (
        <span
          className={`inline-block w-28 rounded-md py-1 text-center text-xs font-bold ${STATUS_TONE[row.original.status]}`}
        >
          {row.original.status}
        </span>
      ),
    },
    {
      id: "action",
      header: "Action",
      meta: { center: true },
      cell: ({ row }) => {
        const w = row.original;
        const isAssigned = Boolean(w.fisher_id);

        return (
          <button
            type="button"
            onClick={(event) => {
              returnFocusRef.current = event.currentTarget;
              setAssignmentError("");
              if (isAssigned) {
                unassign(w);
              } else {
                setAssigning(w);
              }
            }}
            className={`inline-block w-28 rounded-md py-1 text-center text-xs font-semibold ${
              isAssigned
                ? "bg-red-100 text-red-700 hover:bg-red-200"
                : "bg-aqua/25 text-sky-500 hover:bg-aqua/40"
            }`}
          >
            {isAssigned ? "Unassign" : "Assign"}
          </button>
        );
      },
    },
  ];

  const assignedColumns = [
    { accessorKey: "id", header: "Wristband ID" },
    { accessorKey: "fisher", header: "Fisher name" },
    { accessorKey: "checkIn", header: "Checked-in", meta: { center: true } },
    { accessorKey: "checkOut", header: "Checked-out", meta: { center: true } },
  ];

  const isAll = tab === "all";

  return (
    <>
      <PageHeader
        title="Wristbands"
        subtitle="Manage monitored wristband and attached names of the Fishers."
      />

      <div
        role="group"
        aria-label="Wristband views"
        className="mb-5 inline-flex w-fit items-center gap-1 rounded-full bg-aqua/15 p-1"
      >
        <ToggleButton
          active={isAll}
          onClick={() => setTab("all")}
          icon="watch-check"
        >
          All Wristbands
        </ToggleButton>

        <ToggleButton
          active={!isAll}
          onClick={() => setTab("checked-out")}
          icon="watch-cross"
        >
          Checked-Out Wristbands
        </ToggleButton>
      </div>

      <Panel className="flex-1">
        <div className="mb-4 flex min-w-0 flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <h2 className="min-w-0 text-xl font-semibold leading-snug text-brand sm:text-2xl">
            {isAll ? "Registered Wristbands" : "Assigned Wristbands"}
          </h2>

          {isAll && (
            <div className="flex min-w-0 flex-wrap gap-2 text-sm text-brand sm:gap-3 sm:text-base">
              <span className="max-w-full rounded-full bg-aqua/30 px-3 py-1.5 sm:px-5">
                Registered: {registered.length}
              </span>

              <span className="max-w-full rounded-full bg-aqua/30 px-3 py-1.5 sm:px-5">
                Assigned: {assignedRows.length}
              </span>
            </div>
          )}
        </div>

        <div className="relative mb-5">
          <Image
            src="/search.svg"
            alt=""
            width={20}
            height={20}
            className="absolute left-4 top-1/2 -translate-y-1/2"
          />

          <input
            aria-label="Search by fisher's name"
            placeholder="Search by fisher's name"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            className="h-12 w-full rounded-lg border border-aqua/40 bg-mist pl-12 pr-4 text-sm outline-none placeholder:text-gray-400 focus:border-brand"
          />
        </div>

        {loadError && (
          <p role="alert" className="mb-4 text-sm text-red-600">
            {loadError}
          </p>
        )}

        <Suspense fallback={null}>
          {isAll ? (
            <DataTable
              columns={allColumns}
              data={allRows}
              getRowId={(w) => w.wristband_id}
              empty={
                isLoading ? "Loading wristbands..." : "No wristbands found."
              }
            />
          ) : (
            <DataTable
              columns={assignedColumns}
              data={checkedOutRows}
              getRowId={(w) => w.wristband_id}
              empty={
                isLoading
                  ? "Loading wristbands..."
                  : "No assigned wristbands found."
              }
            />
          )}
        </Suspense>
      </Panel>

      {assigning && (
        <AssignModal
          wristband={assigning}
          fishers={fishers}
          fishersError={fishersError}
          assignmentError={assignmentError}
          isAssigning={isAssigning}
          returnFocusRef={returnFocusRef}
          onClose={() => {
            setAssignmentError("");
            setAssigning(null);
          }}
          onAssign={assign}
        />
      )}
    </>
  );
}
</file>

