                        latestSOS.status === "Resolved"
                          ? "bg-[#d1fae5] text-[#065f46]"
                          : latestSOS.status === "Failed"
                            ? "bg-[#fecaca] text-[#991b1b]"
                            : "bg-red-200 text-red-800"
                      }`}
                    >
                      {latestSOS.status || "—"}
