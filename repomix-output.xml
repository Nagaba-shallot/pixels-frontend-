<file path="app/(dashboard)/responders/hooks/useResponderData.js">
"use client";

import { useEffect, useState, useCallback } from "react";
import { getResponders } from "../lib/api";

function describeError(label, error) {
  if (error?.status === 401) {
    return "Your session has expired. Please sign in again.";
  }
  if (error?.status === 403) {
    return "You do not have access to this data.";
  }
  return `Could not load ${label}: ${error?.message ?? "Something went wrong"}`;
}

export function useResponderData() {
  const [responders, setResponders] = useState([]);
  const [errors, setErrors] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [retryCount, setRetryCount] = useState(0);

  const retry = useCallback(() => {
    setIsLoading(true);
    setErrors([]);
    setRetryCount((c) => c + 1);
  }, []);

  useEffect(() => {
    let isCancelled = false;

    getResponders()
      .then((result) => {
        if (isCancelled) return;
        setResponders(result);
        setErrors([]);
        setIsLoading(false);
      })
      .catch((error) => {
        if (isCancelled) return;
        setErrors([describeError("responders", error)]);
        setIsLoading(false);
      });

    return () => {
      isCancelled = true;
    };
  }, [retryCount]);

  return { responders, errors, isLoading, retry };
}
</file>

<file path="app/(dashboard)/responders/lib/api.js">
import { api } from "@/lib/api";

async function getAllLocations() {
  const records = [];
  let skip = 0;
  const limit = 500;

  while (true) {
    const page = await api.getLocations(skip, limit);
    if (!Array.isArray(page)) break;

    records.push(...page);
    if (page.length < limit) break;
    skip += limit;
  }
  return records;
}

function toResponder(record, fisher, location) {
  return {
    id: record.alert_responder_id,
    name: fisher?.full_name ?? "Responder Fisher",
    phone: fisher?.phone_number ?? null,
    status: record.arrived_at ? "available" : "busy",
    latitude: location?.latitude ?? null,
    longitude: location?.longitude ?? null,
    distance_km: record.distance_m == null ? null : record.distance_m / 1000,
  };
}

export async function getResponders() {
  const [alerts, fishers, locations] = await Promise.all([
    api.getAllAlerts(),
    api.getAllFishers(),
    getAllLocations(),
  ]);

  const activeAlerts = alerts.filter((a) => !a.resolved_at);

  const fisherMap = fishers.reduce((acc, f) => {
    acc[f.fisher_id] = f;
    return acc;
  }, {});

  const locationMap = locations.reduce((acc, l) => {
    acc[l.fisher_id] = l;
    return acc;
  }, {});

  const responderPromises = activeAlerts.map((alert) =>
    api.getRespondersByAlert(alert.alert_id),
  );

  const respondersArray = await Promise.all(responderPromises);

  const allResponders = respondersArray.flat().map((record) => {
    const fisher = fisherMap[record.responder_fisher_id];
    const location = locationMap[record.responder_fisher_id];
    return toResponder(record, fisher, location);
  });

  return allResponders;
}
</file>

